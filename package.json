{
  "name": "some-icons-website",
  "version": "1.0.0",
  "description": "Monorepo: Some Icons website and shared design system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/icons",
    "start": "npm run start --workspace=apps/icons",
    "build": "npm run build --workspace=apps/icons",
    "build:icons": "npm run build --workspace=apps/icons",
    "dev:icons": "npm run dev --workspace=apps/icons",
    "dev:ui-docs": "npm run dev --workspace=apps/ui-docs",
    "storybook": "npm run storybook --workspace=apps/ui-docs",
    "build:storybook": "npm run build-storybook --workspace=apps/ui-docs",
    "dev:marketing": "npm run dev --workspace=apps/marketing",
    "generate-changelog": "npm run generate-changelog --workspace=apps/icons",
    "watch-changelog": "npm run watch-changelog --workspace=apps/icons"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "react": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "sonner": "^2.0.7"
  }
}
