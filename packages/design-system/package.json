{
  "name": "@someicons/design-system",
  "version": "0.1.0",
  "description": "Shared visual language and React components for the Some Icons ecosystem: design tokens (CSS custom properties) plus accessible, themeable React components.",
  "license": "MIT",
  "author": "Seaham0606",
  "homepage": "https://github.com/Seaham0606/some-icons-website/tree/main/packages/design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seaham0606/some-icons-website.git",
    "directory": "packages/design-system"
  },
  "bugs": {
    "url": "https://github.com/Seaham0606/some-icons-website/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "design-tokens",
    "icons",
    "someicons"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "someIconsCdnBaseUrl": "https://raw.githubusercontent.com/Seaham0606/some-icons-cdn/main/",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "design.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components.css": "./dist/components.css",
    "./tokens/theme.css": "./dist/tokens/theme.css",
    "./tokens/semantic.css": "./dist/tokens/semantic.css",
    "./tokens/scrollbar.css": "./dist/tokens/scrollbar.css",
    "./tokens/index.css": "./dist/tokens/index.css",
    "./tokens": "./dist/tokens/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "react-colorful": "^5.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
